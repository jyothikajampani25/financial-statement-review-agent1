NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=fs-review-agent@localhost
NOTIFY_WEBHOOK_URL=
